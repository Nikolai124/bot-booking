# Скопируй файл в .env и впиши свои значения
BOT_TOKEN=[ТОКЕН_БОТА]
# Telegram ID мастера/админа: ему приходят новые записи и доступна команда /admin
ADMIN_ID=[ТВОЙ_ID]
# Локально можно не трогать — будет файл bookings.db. На Render сюда вставляется строка подключения к PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///bookings.db
# Любая случайная строка, нужна только на сервере для проверки запросов от Telegram
WEBHOOK_SECRET=[СЛУЧАЙНАЯ_СТРОКА]
